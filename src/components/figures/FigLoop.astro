<svg viewBox="0 0 440 300" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Quarterly loop: map, fix, grows, next">
  <defs>
    <marker id="gm4-ink" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#14261A" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
    <marker id="gm4-moss" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#26773F" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>


  <!-- concentric inner ring (brand motif) -->
  <circle cx="220" cy="152" r="56" fill="none" stroke="rgba(20,38,26,0.15)" stroke-width="1.6" stroke-dasharray="3 4"/>

  <!-- arcs, clockwise -->
  <path d="M 238.9 76.3 A 78 78 0 0 1 295.7 133.1" fill="none" stroke="#14261A" stroke-width="1.9" marker-end="url(#gm4-ink)"/>
  <path d="M 295.7 170.9 A 78 78 0 0 1 238.9 227.7" fill="none" stroke="#14261A" stroke-width="1.9" marker-end="url(#gm4-ink)"/>
  <path d="M 201.1 227.7 A 78 78 0 0 1 144.3 170.9" fill="none" stroke="#14261A" stroke-width="1.9" marker-end="url(#gm4-ink)"/>
  <!-- the returning arc is dashed moss: the loop begins again -->
  <path d="M 144.3 133.1 A 78 78 0 0 1 201.1 76.3" fill="none" stroke="#26773F" stroke-width="1.9" stroke-dasharray="5 4" marker-end="url(#gm4-moss)"/>

  <!-- station dots -->
  <circle cx="220" cy="74" r="5" fill="#26773F"/>
  <circle cx="298" cy="152" r="5" fill="#FFFFFF" stroke="#14261A" stroke-width="1.9"/>
  <circle cx="220" cy="230" r="5" fill="#FFFFFF" stroke="#14261A" stroke-width="1.9"/>
  <circle cx="142" cy="152" r="5" fill="#FFFFFF" stroke="#14261A" stroke-width="1.9"/>

  <!-- station labels -->
  <text x="220" y="58" text-anchor="middle" font-family="'Jost', sans-serif" font-size="10" letter-spacing="0.14em" fill="#26773F">MAP</text>
  <text x="314" y="156" font-family="'Jost', sans-serif" font-size="10" letter-spacing="0.14em" fill="#14261A">FIX</text>
  <text x="220" y="252" text-anchor="middle" font-family="'Jost', sans-serif" font-size="10" letter-spacing="0.14em" fill="#14261A">GROWS</text>
  <text x="126" y="156" text-anchor="end" font-family="'Jost', sans-serif" font-size="10" letter-spacing="0.14em" fill="#14261A">NEXT</text>

  <!-- center -->
  <text x="220" y="148" text-anchor="middle" font-family="'Jost', sans-serif" font-size="9.5" letter-spacing="0.14em" fill="#6E6E6E">EVERY</text>
  <text x="220" y="163" text-anchor="middle" font-family="'Jost', sans-serif" font-size="9.5" letter-spacing="0.14em" fill="#6E6E6E">QUARTER</text>
</svg>