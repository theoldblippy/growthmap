---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Growth Map | Book a Free Business Growth Diagnostic"
  description="Book a free Growth Map Diagnostic to identify what's stalling your business growth. Fractional COO and operations consulting for founders."
  canonicalPath="/contact"
>
  <!-- HEADER -->
  <section class="px-6 pt-16 pb-10 md:pt-24">
    <div class="mx-auto max-w-[800px] text-center">
      <p class="mb-5 font-mono text-[11.5px] font-medium uppercase tracking-[0.18em] text-moss">
        Get in Touch
      </p>
      <h1 class="font-display text-4xl leading-[1.1] text-ink sm:text-5xl md:text-[48px]">
        Want to talk through your business?
      </h1>
    </div>
  </section>

  <!-- BOOKING CTA -->
  <section class="bg-parchment-deep px-6 py-14">
    <div class="mx-auto max-w-[600px] text-center">
      <h2 class="font-display text-2xl text-ink">Book a free consult.</h2>
      <p class="mt-4 text-lg leading-relaxed text-fern">
        Pick a time. Thirty minutes, no pitch. We'll figure out where your business is and whether I can help.
      </p>
      <a
        href="https://calendar.notion.so/meet/cameronearloliver/qc3y04oud"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block rounded-full border border-ink bg-ink px-8 py-3.5 text-base font-semibold text-parchment transition-opacity hover:opacity-90"
      >
        Book a Free Consult
      </a>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="px-6 py-16 md:py-20">
    <div class="mx-auto max-w-[600px]">
      <h2 class="font-display text-2xl text-ink">Send me a message.</h2>
      <p class="mt-2 text-lg leading-relaxed text-fern">
        If you're unsure what your next step should be, send me a note. I read every message personally.
      </p>

      <form
        id="contact-form"
        action="https://formspree.io/f/xkoqqldw"
        method="POST"
        class="mt-8 space-y-5"
      >
        <!-- Honeypot for spam -->
        <input type="text" name="_gotcha" style="display:none" />

        <div>
          <label for="name" class="block font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-fern">Full Name</label>
          <input
            type="text"
            name="name"
            id="name"
            required
            class="mt-2 w-full rounded-lg border border-hairline bg-white/60 px-4 py-3 text-ink transition-colors placeholder:text-fern/60 focus:border-moss focus:outline-none focus:ring-1 focus:ring-moss"
            placeholder="Your name"
          />
        </div>

        <div>
          <label for="email" class="block font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-fern">Email</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="mt-2 w-full rounded-lg border border-hairline bg-white/60 px-4 py-3 text-ink transition-colors placeholder:text-fern/60 focus:border-moss focus:outline-none focus:ring-1 focus:ring-moss"
            placeholder="you@example.com"
          />
        </div>

        <div>
          <label for="message" class="block font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-fern">Message</label>
          <textarea
            name="message"
            id="message"
            required
            rows="5"
            class="mt-2 w-full rounded-lg border border-hairline bg-white/60 px-4 py-3 text-ink transition-colors placeholder:text-fern/60 focus:border-moss focus:outline-none focus:ring-1 focus:ring-moss"
            placeholder="Tell me about your business and what you're working on..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full rounded-full border border-ink bg-ink px-8 py-3.5 text-base font-semibold text-parchment transition-opacity hover:opacity-90"
        >
          Send Message
        </button>
      </form>

      <!-- Success message -->
      <div id="form-success" class="mt-6 hidden rounded-lg border border-moss/30 bg-moss/10 p-4 text-ink">
        Thanks! I'll be in touch soon.
      </div>

      <!-- Error message -->
      <div id="form-error" class="mt-6 hidden rounded-lg border border-rust/30 bg-rust/10 p-4 text-rust">
        Something went wrong. Try again or email me directly.
      </div>
    </div>
  </section>

  <!-- NOT READY -->
  <section class="bg-parchment-deep px-6 py-14">
    <div class="mx-auto max-w-[600px] text-center">
      <h2 class="font-display text-xl text-ink">Not ready to talk yet?</h2>
      <p class="mt-3 leading-relaxed text-fern">Try one of the free tools to see where your business stands.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a
          href="/time-audit"
          class="inline-block rounded-full border border-hairline bg-white/35 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-ink"
        >
          CEO Time Audit
        </a>
        <a
          href="/scale-readiness-score"
          class="inline-block rounded-full border border-hairline bg-white/35 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-ink"
        >
          Scale Readiness Score
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    successEl?.classList.add('hidden');
    errorEl?.classList.add('hidden');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.reset();
        successEl?.classList.remove('hidden');
      } else {
        errorEl?.classList.remove('hidden');
      }
    } catch {
      errorEl?.classList.remove('hidden');
    }
  });
</script>
