---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const published = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const essays = published.filter((post) => !post.data.guide);
const guides = published.filter((post) => post.data.guide);
---

<Layout
  title="Field Notes | Growth Map - Fractional COO & Business Operations Insights"
  description="Practical insights on fractional COO leadership, business operations, and growth strategy for founders scaling from $1M to $10M."
  canonicalPath="/blog"
>
  <section class="border-b border-hairline px-6 py-16 md:py-24">
    <div class="mx-auto max-w-[800px]">
      <p class="doc-label text-ink"><b>→</b>Field Notes</p>
      <h1 class="font-display mt-7 text-4xl leading-[1.1] text-ink sm:text-5xl md:text-[48px]">
        I write about this work.
      </h1>
      <p class="mt-4 max-w-[54ch] text-lg leading-relaxed text-fern">
        Essays on growth, operations, and building a business that runs without you — from inside the work, not above it. Plus a shelf of evergreen guides.
      </p>
    </div>
  </section>

  <section class="px-6 py-12 md:py-16">
    <div class="mx-auto max-w-[800px]">
      <p class="doc-label text-ink"><b>A</b>Essays</p>
      {essays.length === 0 && (
        <p class="py-6 text-fern">No essays yet. Check back soon.</p>
      )}
      {essays.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block border-b border-hairline py-7 no-underline"
        >
          <time class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-fern">
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <h2 class="font-display mt-2 text-[24px] leading-snug text-ink transition-colors group-hover:text-moss">
            {post.data.title}
          </h2>
          <p class="mt-2 max-w-[64ch] leading-relaxed text-fern">{post.data.description}</p>
          <span class="mt-3 inline-block font-mono text-xs font-medium uppercase tracking-[0.14em] text-moss">
            Read &rarr;
          </span>
        </a>
      ))}

      <p class="doc-label mt-16 text-ink"><b>B</b>Guides</p>
      <p class="mt-4 text-[15px] leading-relaxed text-fern">
        Evergreen how-tos and explainers. Useful, searchable, less personal than the essays above.
      </p>
      <div class="mt-2">
        {guides.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group flex items-baseline justify-between gap-6 border-b border-dashed border-hairline py-4 no-underline"
          >
            <span class="font-display text-[19px] leading-snug text-ink transition-colors group-hover:text-moss">
              {post.data.title}
            </span>
            <span class="flex-shrink-0 font-mono text-xs font-medium text-moss">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools cross-link -->
  <section class="px-6 pb-16">
    <div class="mx-auto max-w-[800px] rounded-[14px] border border-hairline bg-white/50 p-8 text-center">
      <h2 class="font-display text-2xl text-ink">Want to see where your business stands?</h2>
      <p class="mt-2 leading-relaxed text-fern">The free tools give you a clear picture in under 3 minutes.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a
          href="/time-audit"
          class="inline-block rounded-full border border-ink bg-ink px-6 py-3 text-sm font-semibold text-parchment transition-opacity hover:opacity-90"
        >
          Take the CEO Time Audit
        </a>
        <a
          href="/scale-readiness-score"
          class="inline-block rounded-full border border-hairline bg-white/35 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-ink"
        >
          Scale Readiness Score
        </a>
      </div>
    </div>
  </section>
</Layout>
