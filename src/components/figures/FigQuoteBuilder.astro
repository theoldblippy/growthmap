<svg viewBox="0 0 440 240" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Before and after: a stack of old bids taking ten hours becomes one clean quote in about an hour">
  <defs>
    <marker id="gm5-ink" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#14261A" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>


  <!-- messy stack of old bids -->
  <g transform="rotate(-7 100 136)">
    <rect x="64" y="92" width="70" height="86" rx="4" fill="#FFFFFF" stroke="rgba(20,38,26,0.4)" stroke-width="1.1"/>
  </g>
  <g transform="rotate(6 116 148)">
    <rect x="81" y="105" width="70" height="86" rx="4" fill="#FFFFFF" stroke="rgba(20,38,26,0.4)" stroke-width="1.1"/>
  </g>
  <g transform="rotate(-2 98 156)">
    <rect x="60" y="113" width="70" height="86" rx="4" fill="#FFFFFF" stroke="rgba(20,38,26,0.6)" stroke-width="1.9"/>
    <line x1="70" y1="131" x2="118" y2="131" stroke="rgba(20,38,26,0.3)" stroke-width="1.1"/>
    <line x1="70" y1="143" x2="118" y2="143" stroke="rgba(20,38,26,0.3)" stroke-width="1.1"/>
    <line x1="70" y1="155" x2="110" y2="155" stroke="rgba(20,38,26,0.3)" stroke-width="1.1"/>
    <line x1="70" y1="167" x2="116" y2="167" stroke="rgba(20,38,26,0.3)" stroke-width="1.1"/>
  </g>
  <!-- calculator -->
  <g transform="rotate(8 134 182)">
    <rect x="120" y="164" width="28" height="36" rx="3" fill="#FFFFFF" stroke="#14261A" stroke-width="1.9"/>
    <rect x="125" y="169" width="18" height="7" fill="none" stroke="rgba(20,38,26,0.5)" stroke-width="1.6"/>
    <circle cx="128" cy="183" r="1.3" fill="rgba(20,38,26,0.55)"/><circle cx="134" cy="183" r="1.3" fill="rgba(20,38,26,0.55)"/><circle cx="140" cy="183" r="1.3" fill="rgba(20,38,26,0.55)"/>
    <circle cx="128" cy="191" r="1.3" fill="rgba(20,38,26,0.55)"/><circle cx="134" cy="191" r="1.3" fill="rgba(20,38,26,0.55)"/><circle cx="140" cy="191" r="1.3" fill="rgba(20,38,26,0.55)"/>
  </g>
  <text x="104" y="222" text-anchor="middle" font-family="'Jost', sans-serif" font-size="9" letter-spacing="0.14em" fill="#6E6E6E">10 HRS</text>

  <!-- through the builder -->
  <line x1="162" y1="140" x2="190" y2="140" stroke="#14261A" stroke-width="1.9" marker-end="url(#gm5-ink)"/>
  <rect x="198" y="108" width="62" height="64" rx="7" fill="#FFFFFF" stroke="#14261A" stroke-width="2.1"/>
  <line x1="212" y1="120" x2="246" y2="120" stroke="rgba(20,38,26,0.4)" stroke-width="1.1"/>
  <path d="M219 133 l9 7 l-9 7" fill="none" stroke="#14261A" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M235 133 l9 7 l-9 7" fill="none" stroke="#14261A" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="229" y="190" text-anchor="middle" font-family="'Jost', sans-serif" font-size="8" letter-spacing="0.12em" fill="#6E6E6E">THE BUILDER</text>
  <line x1="266" y1="140" x2="292" y2="140" stroke="#14261A" stroke-width="1.9" marker-end="url(#gm5-ink)"/>

  <!-- one clean quote -->
  <rect x="300" y="78" width="92" height="124" rx="6" fill="#FFFFFF" stroke="#26773F" stroke-width="1.5"/>
  <text x="312" y="98" font-family="'Jost', sans-serif" font-size="8" letter-spacing="0.12em" fill="#6E6E6E">QUOTE</text>
  <line x1="312" y1="106" x2="380" y2="106" stroke="rgba(20,38,26,0.15)" stroke-width="1.6"/>
  <line x1="312" y1="120" x2="380" y2="120" stroke="rgba(20,38,26,0.35)" stroke-width="1.1"/>
  <line x1="312" y1="134" x2="380" y2="134" stroke="rgba(20,38,26,0.35)" stroke-width="1.1"/>
  <line x1="312" y1="148" x2="372" y2="148" stroke="rgba(20,38,26,0.35)" stroke-width="1.1"/>
  <line x1="312" y1="164" x2="380" y2="164" stroke="rgba(20,38,26,0.5)" stroke-width="1.6"/>
  <text x="312" y="182" font-family="'Jost', sans-serif" font-size="8" letter-spacing="0.12em" fill="#14261A">TOTAL</text>
  <path d="M362 176 l5 6 l10 -12" fill="none" stroke="#26773F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="346" y="222" text-anchor="middle" font-family="'Jost', sans-serif" font-size="9" letter-spacing="0.14em" fill="#26773F">~1 HR</text>
</svg>