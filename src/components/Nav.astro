---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/about', label: 'About' },
  { href: '/results', label: 'Results' },
  { href: '/tools-apps', label: 'Tools & Apps' },
  { href: '/blog', label: 'Field Notes' },
];
const bookUrl = 'https://calendar.notion.so/meet/cameronearloliver/qc3y04oud';
const isOn = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---

<!-- Announcement bar -->
<div class="bg-forest px-6 py-2.5 text-center">
  <p class="text-[13.5px] text-white/85">
    Not sure what's actually broken?
    <a href="/diagnostic" class="ml-1 font-semibold text-white underline decoration-sprout decoration-2 underline-offset-4">Take the free diagnostic &rarr;</a>
  </p>
</div>

<header id="site-nav" class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm transition-shadow duration-300">
  <nav class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-4">
    <a href="/" class="font-display flex-shrink-0 text-[22px] no-underline">
      Growth Map<span class="text-moss">.</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'text-[15px] font-medium transition-colors hover:text-forest',
              isOn(href) ? 'text-moss' : 'text-fern',
            ]}
          >{label}</a>
        </li>
      ))}
      <li>
        <a
          href={bookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-full bg-moss px-6 py-2.5 text-[14.5px] font-semibold text-white transition-opacity hover:opacity-90"
        >Book a call</a>
      </li>
    </ul>

    <button id="mobile-menu-btn" class="flex flex-col gap-1.5 md:hidden" aria-label="Toggle menu" aria-expanded="false">
      <span class="block h-0.5 w-6 bg-forest"></span>
      <span class="block h-0.5 w-6 bg-forest"></span>
      <span class="block h-0.5 w-6 bg-forest"></span>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-hairline bg-white md:hidden">
    <ul class="flex flex-col gap-4 px-6 py-6">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class:list={['block text-[17px] font-semibold', isOn(href) ? 'text-moss' : 'text-forest']}>{label}</a>
        </li>
      ))}
      <li>
        <a href={bookUrl} target="_blank" rel="noopener noreferrer" class="inline-block rounded-full bg-moss px-6 py-3 text-[15px] font-semibold text-white">Book a call</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) nav?.classList.add('shadow-md');
    else nav?.classList.remove('shadow-md');
  });
</script>
