---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Growth Map"
  description="The page you're looking for doesn't exist. Head back to the Growth Map homepage."
  canonicalPath="/404"
>
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-6 py-24 text-center">
    <p class="text-[14.5px] font-semibold text-moss">ERR 404 · OFF THE MAP</p>
    <h1 class="font-display mt-5 text-4xl text-ink sm:text-5xl">You're off the map.</h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-fern">
      This page doesn't exist or may have moved. Here are a few routes back:
    </p>
    <div class="mt-9 flex flex-col gap-4 sm:flex-row">
      <a
        href="/"
        class="rounded-full border border-ink bg-ink px-8 py-3.5 text-base font-semibold text-parchment transition-opacity hover:opacity-90"
      >
        Go to homepage
      </a>
      <a
        href="/blog"
        class="rounded-full bg-white shadow-[0_2px_10px_rgba(20,38,26,.07)] px-8 py-3.5 text-base font-semibold text-ink transition-colors hover:border-ink"
      >
        Read the field notes
      </a>
    </div>
  </section>
</Layout>
