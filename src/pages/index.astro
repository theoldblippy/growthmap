---
import Layout from '../layouts/Layout.astro';
import FigMap from '../components/figures/FigMap.astro';
import FigScorecard from '../components/figures/FigScorecard.astro';
import FigBottleneck from '../components/figures/FigBottleneck.astro';
import FigLoop from '../components/figures/FigLoop.astro';
import FigLine from '../components/figures/FigLine.astro';

const bookUrl = 'https://calendar.notion.so/meet/cameronearloliver/qc3y04oud';

const steps = [
  { n: '01', title: 'I map how you make money', body: "Every way you get a customer, and everything you do to keep them. Just this alone opens your eyes to the opportunities you're wasting." },
  { n: '02', title: 'We see what it takes to deliver', body: 'What each part actually needs to run: people, technology, resources.' },
  { n: '03', title: 'We find the one thing to fix first', body: 'The bottleneck that keeps rearing its head until we eliminate it. I help you knock it out, then we go find the next one.' },
  { n: '04', title: 'We keep it running', body: "A simple rhythm the team can hold on their own, so everyone knows their number and their job, and you can finally see what's working without standing over it." },
];

const getQ = [
  "When I stop selling, the sales stop.",
  "Our close rate keeps slipping and I can't tell you why.",
  "Leads come in, then just seem to disappear.",
];
const serveQ = [
  "The team can't run the work without me watching it.",
  "We win the customer, then the wheels come off in delivery.",
  "Everything that makes this place work is in my head, not a system.",
];
const biggerQ = [
  "I need to hire, but is it a salesperson or an operator?",
  "I've got capital to put to work and don't know where it actually moves the needle.",
  "Is it time for a second location, or would that just multiply the chaos?",
  "I hit the revenue number, so why is there no cash in the bank?",
  "I couldn't take a two-week vacation without the whole thing wobbling.",
];

const fitYes = [
  "You own the place, so you can actually make the call.",
  "You want the thing fixed, not documented.",
  "You're willing to hear what I actually think.",
];
const fitNo = [
  "You want a strategy deck and a recommendation.",
  "You want someone to tell you you're already right.",
  "You need a full-time executive, not a part-time operator.",
];

const faqs = [
  { q: "What's a fractional COO?", a: "An operator who runs alongside you part-time instead of joining full-time. I get into the business, find what's really holding growth back, and fix it with your team, without the cost of a full-time exec." },
  { q: "Who do you work with?", a: "Owner-led businesses, roughly $1M to $20M in revenue, across construction, professional services, healthcare, software, and agencies. If you've become the bottleneck and growth has gotten chaotic, that's my wheelhouse." },
  { q: "What happens on the call?", a: "Thirty minutes, no pitch. You tell me where it's stuck, I tell you what I'd fix first. You can run with that yourself, or we can talk about doing it together." },
  { q: "What does it cost?", a: "I don't price anything before I understand the problem. Once I do, the price is tied to what fixing it is worth to you rather than to hours. You'll have the number before anything starts, and I'll tell you if I don't think it's worth doing." },
  { q: "Do you work remotely?", a: "Yes. I work remotely with owners across the US, and get on-site when the work calls for it." },
];
---

<Layout
  title="Growth Map | Grow revenue without the chaos"
  description="Most owner-led businesses hit a point where growing just means more chaos. I'm an operator who gets in the trenches, finds what's actually holding the business back, and fixes it with you. Book a free call."
  canonicalPath="/"
>
  <!-- 2 · HERO -->
  <section class="px-6 pb-20 pt-20 md:pb-28 md:pt-28">
    <div class="mx-auto max-w-[820px] text-center">
      <h1 class="font-display text-[42px] leading-[1.08] sm:text-[54px] md:text-[62px]">
        Grow revenue <em class="mark whitespace-nowrap">without the chaos</em>.
      </h1>
      <p class="mx-auto mt-7 max-w-[58ch] text-[18px] leading-[1.65] text-fern md:text-[19px]">
        Most owner-led businesses hit a point where growing just means more mess. More people, more moving parts, more of it running through you. I get in the trenches, find what's actually holding it back, and we fix it together.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3.5">
        <a href={bookUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-moss px-8 py-4 text-[15px] font-semibold text-white transition-opacity hover:opacity-90">Book a call</a>
        <a href="/diagnostic" class="rounded-full border-[1.5px] border-forest bg-white px-8 py-4 text-[15px] font-semibold text-forest transition-colors hover:bg-forest hover:text-white">Take the diagnostic</a>
      </div>
      <p class="mt-4 text-[14px] text-muted">A free 30-minute call.</p>
    </div>
  </section>

  <!-- 3 · THE PROBLEM -->
  <section class="bg-parchment-deep px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[1060px]">
      <h2 class="font-display mx-auto max-w-[20ch] text-center text-[34px] leading-[1.15] md:text-[42px]">
        Every business does <em>two things</em>.
      </h2>

      <div class="mx-auto mt-12 grid max-w-[900px] items-stretch gap-6 md:grid-cols-[1fr_auto_1fr]">
        <div class="rounded-[20px] border-2 border-moss/25 bg-white p-10 text-center">
          <p class="font-display text-[62px] leading-none text-moss">1</p>
          <h3 class="font-display mt-5 text-[26px]">Get customers</h3>
          <p class="mt-3 text-[16.5px] leading-relaxed text-fern">You have to find people and get them to buy.</p>
        </div>
        <div class="flex items-center justify-center">
          <span class="font-display text-[34px] leading-none text-moss md:rotate-0">&rarr;</span>
        </div>
        <div class="rounded-[20px] border-2 border-moss/25 bg-white p-10 text-center">
          <p class="font-display text-[62px] leading-none text-moss">2</p>
          <h3 class="font-display mt-5 text-[26px]">Serve those customers</h3>
          <p class="mt-3 text-[16.5px] leading-relaxed text-fern">You have to deliver, and keep them coming back.</p>
        </div>
      </div>

      <p class="mx-auto mt-14 max-w-[60ch] text-center font-display text-[26px] leading-[1.35] md:text-[30px]">
        Whatever you're wrestling with lives in one of those two. And it's almost never <em>the one you think</em>.
      </p>
      <p class="mx-auto mt-6 max-w-[54ch] text-center text-[18px] leading-relaxed text-fern">
        Here's what it usually sounds like out loud.
      </p>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div class="rounded-[18px] bg-white p-8 shadow-[0_2px_10px_rgba(20,38,26,.07)]">
          <p class="text-[15px] font-semibold text-moss">Getting customers</p>
          <ul class="mt-4 space-y-3.5">
            {getQ.map((q) => (<li class="text-[16.5px] leading-snug text-forest">&ldquo;{q}&rdquo;</li>))}
          </ul>
        </div>
        <div class="rounded-[18px] bg-white p-8 shadow-[0_2px_10px_rgba(20,38,26,.07)]">
          <p class="text-[15px] font-semibold text-moss">Serving customers</p>
          <ul class="mt-4 space-y-3.5">
            {serveQ.map((q) => (<li class="text-[16.5px] leading-snug text-forest">&ldquo;{q}&rdquo;</li>))}
          </ul>
        </div>
      </div>

      <div class="mx-auto mt-10 max-w-[900px] rounded-[18px] border border-hairline p-8">
        <p class="text-[15px] font-semibold text-muted">And underneath both, the calls only you can make</p>
        <ul class="mt-4 grid gap-3.5 md:grid-cols-2">
          {biggerQ.map((q) => (<li class="text-[16.5px] leading-snug text-forest">&ldquo;{q}&rdquo;</li>))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 4 · THE TURN -->
  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[680px] text-center">
      <h2 class="font-display text-[34px] leading-[1.15] md:text-[42px]">When it's working, you can <em>feel it</em>.</h2>
      <p class="mt-7 text-[18px] leading-[1.7] text-fern">
        The chaos settles down. Your team stops waiting on you to unblock them. You get to look a quarter ahead instead of at today. That's the whole point of this, and it's a lot closer than it feels right now.
      </p>
    </div>
  </section>

  <!-- 5 · WHO I AM -->
  <section class="bg-parchment-deep px-6 py-20 md:py-24">
    <div class="mx-auto grid max-w-[940px] items-center gap-12 md:grid-cols-[300px_1fr]">
      <div class="mx-auto w-full max-w-[300px]">
        <img src="/images/sneakers.jpg" alt="Cameron Oliver" class="w-full rounded-[20px] shadow-[0_4px_20px_rgba(20,38,26,.12)]" loading="lazy" />
      </div>
      <div>
        <h2 class="font-display text-[32px] leading-[1.15] md:text-[38px]">Hi, I'm Cameron.</h2>
        <p class="mt-6 text-[18px] leading-[1.7] text-fern">
          I've spent my career operating inside owner-led businesses. These days I run operations at a health tech company, and I work with a handful of owners on the side, mostly on the stuff that quietly caps growth.
        </p>
        <p class="mt-4 text-[18px] leading-[1.7] text-fern">
          More often than not I end up building the fix rather than writing a report about it.
        </p>
        <a href="/about" class="mt-6 inline-block text-[16px] font-semibold text-moss underline decoration-2 underline-offset-4 hover:text-forest">More about how I work &rarr;</a>
      </div>
    </div>
  </section>

  <!-- 7 · WHAT WORKING TOGETHER LOOKS LIKE -->
  <section class="bg-parchment-deep px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[760px]">
      <h2 class="font-display text-[32px] leading-[1.15] md:text-[40px]">
        What working with me <em>looks like</em>.
      </h2>

      <div class="mt-14 space-y-12">

        <div class="flex gap-6">
          <div class="shrink-0 text-moss">
            <svg viewBox="0 0 44 44" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 12h30v18H19l-8 6v-6H7z" /><path d="M15 19h14M15 24h9" /></svg>
          </div>
          <div>
            <p class="text-[14px] font-semibold text-moss">Step one</p>
            <h3 class="font-display mt-1 text-[23px] leading-snug md:text-[25px]">We have a conversation</h3>
            <p class="mt-3 text-[17.5px] leading-[1.7] text-fern">
              We talk for half an hour. I learn a little about your business: what's keeping you up at night, what you think is holding growth back, what you're stressed about.
            </p>
            <p class="mt-3.5 text-[17.5px] leading-[1.7] text-fern">
              I do this part for free. At the end I'll give you a roadmap of what I'd look to fix. You can hand that to your own team and implement it yourselves. If it's not something you should be doing, I'll parachute in.
            </p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="shrink-0 text-moss">
            <svg viewBox="0 0 44 44" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20a18 18 0 0 1 36 0" /><path d="M4 20c4 3 8 3 12 0M16 20c4 3 8 3 12 0M28 20c4 3 8 3 12 0" /><path d="M9 21l11 9M35 21l-11 9" /><rect x="18" y="30" width="8" height="8" rx="2" /></svg>
          </div>
          <div>
            <p class="text-[14px] font-semibold text-moss">Step two</p>
            <h3 class="font-display mt-1 text-[23px] leading-snug md:text-[25px]">I get in there with you</h3>
            <p class="mt-3 text-[17.5px] leading-[1.7] text-fern">
              I get in the ground with you and learn more. We both agree on what's going on, and on what those improvements would actually result in, whether that's the financial model, your personal life, hours worked, or stress.
            </p>
            <p class="mt-3.5 text-[17.5px] leading-[1.7] text-fern">
              I don't give you pricing or a quote until we've identified how painful the issue is and what it's costing the business. I want to solve really hard problems for you.
            </p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="shrink-0 text-moss">
            <svg viewBox="0 0 44 44" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="22" r="6" /><circle cx="22" cy="22" r="6" fill="currentColor" stroke="none" /><circle cx="33" cy="22" r="6" fill="currentColor" stroke="none" /></svg>
          </div>
          <div>
            <p class="text-[14px] font-semibold text-moss">Step three</p>
            <h3 class="font-display mt-1 text-[23px] leading-snug md:text-[25px]">We agree on what to fix</h3>
            <p class="mt-3 text-[17.5px] leading-[1.7] text-fern">
              You and I agree on what we should fix and how I'd approach it. Everything I do has to result in a measurable impact to your financial model, your sales, or your personal life.
            </p>
            <p class="mt-3.5 text-[17.5px] leading-[1.7] text-fern">
              This could be a lot of different things. Sometimes it's sales process, market messaging and lead generation. Sometimes it's OKRs and goal setting. Sometimes it's building a financial model or redoing processes. I can develop my own automations, or I could just stand in as your business partner and COO on an interim basis.
            </p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="shrink-0 text-moss">
            <svg viewBox="0 0 44 44" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 36V24" /><path d="M22 24l-9-9M22 24l9-9" /><path d="M13 15V9M13 15H7" /><path d="M31 15V9M31 15h6" /></svg>
          </div>
          <div>
            <p class="text-[14px] font-semibold text-moss">Step four</p>
            <h3 class="font-display mt-1 text-[23px] leading-snug md:text-[25px]">We decide if it continues</h3>
            <p class="mt-3 text-[17.5px] leading-[1.7] text-fern">
              After the first engagement, or the second, you and I decide together if we want the relationship to continue.
            </p>
          </div>
        </div>

      </div>

      <a href={bookUrl} target="_blank" rel="noopener noreferrer" class="mt-14 inline-block rounded-full bg-moss px-8 py-4 text-[15px] font-semibold text-white transition-opacity hover:opacity-90">Start with the half hour</a>
    </div>
  </section>

  <!-- 9 · SLAB CTA -->
  <section class="bg-forest px-6 py-20 md:py-24">
    <div class="mx-auto max-w-[680px] text-center">
      <h2 class="font-display text-[32px] leading-[1.15] text-white md:text-[40px]">Want to know what I'd fix first?</h2>
      <p class="mx-auto mt-6 max-w-[52ch] text-[18px] leading-relaxed text-white/75">
        Thirty minutes, no pitch. You tell me where it's stuck, I tell you what I'd go after. You can run with that yourself if you want.
      </p>
      <a href={bookUrl} target="_blank" rel="noopener noreferrer" class="mt-9 inline-block rounded-full bg-sprout px-9 py-4 text-[15px] font-semibold text-forest transition-opacity hover:opacity-90">Book a call</a>
    </div>
  </section>

  <!-- 9b · THE WHITEBOARD -->
  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-[1040px] items-center gap-12 md:grid-cols-[1fr_420px]">
      <div>
        <h2 class="font-display text-[32px] leading-[1.15] md:text-[38px]">This is what it actually looks like.</h2>
        <p class="mt-7 text-[18px] leading-[1.7] text-fern">
          That's a photo from a real session. I'm not interested in handing you a document you'll never open. I'd rather get in a room with you, real or virtual, and map out how you actually get customers and how you serve them. Where it stalls. Where the friction is.
        </p>
        <p class="mt-4 text-[18px] leading-[1.7] text-fern">
          By the end it's all on one board, and the most expensive problem usually shows itself. We put a number on that one, and then I dive in and don't stop until it's fixed.
        </p>
      </div>
      <div>
        <img src="/images/whiteboard.jpg" alt="A whiteboard mapping how customers happen and how they get served, with bottlenecks and metrics marked" class="w-full rounded-[18px] shadow-[0_4px_24px_rgba(20,38,26,.16)]" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 10 · HOW IT WORKS -->
  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[1060px]">
      <h2 class="font-display mx-auto max-w-[20ch] text-center text-[34px] leading-[1.15] md:text-[42px]">It all starts with the map.</h2>
      <p class="mx-auto mt-6 max-w-[52ch] text-center text-[18px] leading-relaxed text-fern">
        Understanding how your business actually makes money.
      </p>
      <div class="mt-16 space-y-20">
        {steps.map((st, i) => {
          const Fig = [FigMap, FigScorecard, FigBottleneck, FigLoop][i];
          return (
            <div class:list={["grid items-center gap-8 md:gap-14 md:grid-cols-2", i % 2 === 1 && "md:[&>*:first-child]:order-2"]}>
              <div>
                <p class="font-display text-[17px] text-moss">{st.n}</p>
                <h3 class="font-display mt-2 text-[26px] leading-tight md:text-[30px]">{st.title}</h3>
                <p class="mt-3.5 text-[17px] leading-relaxed text-fern">{st.body}</p>
              </div>
              <div><Fig /></div>
            </div>
          );
        })}
      </div>

      <div class="mt-20 border-t border-hairline pt-16">
        <h3 class="font-display mx-auto max-w-[24ch] text-center text-[28px] leading-[1.2] md:text-[34px]">
          And then you've got a <em>machine</em>.
        </h3>
        <p class="mx-auto mt-6 max-w-[58ch] text-center text-[18px] leading-relaxed text-fern">
          You don't run a factory. But your business works like one, and whatever you sell it's the same line. You just put your own words on the stations.
        </p>
        <div class="mt-10 overflow-x-auto rounded-[18px] bg-parchment-deep p-6 md:p-10">
          <div class="min-w-[620px]"><FigLine /></div>
        </div>
        <p class="mx-auto mt-8 max-w-[58ch] text-center text-[18px] leading-relaxed text-fern">
          Each station is a question you should be able to answer yes to. The one you can't is where the money leaks, and it's where we start.
        </p>
      </div>
    </div>
  </section>

  <!-- 12 · FAQ -->
  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[760px]">
      <h2 class="font-display text-center text-[34px] leading-[1.15] md:text-[40px]">Questions you might have.</h2>
      <div class="mt-12 divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[18px] font-semibold text-forest">
              {f.q}
              <span class="shrink-0 text-[22px] leading-none text-moss transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3.5 text-[16.5px] leading-relaxed text-fern">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 12b · PROOF + GO LOOK -->
  <section class="bg-parchment-deep px-6 py-20 md:py-24">
    <div class="mx-auto max-w-[820px] text-center">
      <p class="font-display text-[26px] leading-[1.35] md:text-[30px]">
        &ldquo;If you doubled your sales tomorrow, would you be happy, or freak out?&rdquo;
      </p>
      <p class="mx-auto mt-6 max-w-[62ch] text-[17.5px] leading-[1.7] text-fern">
        He was chasing more sales, but when I asked him that he got sick to his stomach. He had a throughput problem, not a sales problem. We fixed how the work got delivered and the growth followed.
      </p>
      <p class="mx-auto mt-4 max-w-[62ch] text-[17.5px] leading-[1.7] text-fern">
        There are a few more like that, along with the tools and software I've built for people, over on the results page.
      </p>
      <a href="/results" class="mt-8 inline-block rounded-full border-[1.5px] border-forest bg-white px-8 py-4 text-[15px] font-semibold text-forest transition-colors hover:bg-forest hover:text-white">See the results and what I've built</a>
    </div>
  </section>

  <!-- 13 · FINAL CTA -->
  <section class="border-t border-hairline px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[640px] text-center">
      <h2 class="font-display text-[34px] leading-[1.15] md:text-[44px]">Let's find the <em>one thing</em>.</h2>
      <p class="mt-6 text-[18px] leading-relaxed text-fern">
        Tell me where it's stuck and I'll tell you what I'd fix first.
      </p>
      <a href={bookUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block rounded-full bg-moss px-9 py-4 text-[15px] font-semibold text-white transition-opacity hover:opacity-90">Book a call</a>
    </div>
  </section>
</Layout>
