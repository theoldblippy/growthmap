---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const published = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const essays = published.filter((post) => !post.data.guide);
const guides = published.filter((post) => post.data.guide);
---

<Layout
  title="Field Notes | Growth Map - Fractional COO & Business Operations Insights"
  description="Practical insights on fractional COO leadership, business operations, and growth strategy for founders and owner-operators scaling from $1M to $20M."
  canonicalPath="/blog"
>
  <section class="px-6 pb-14 pt-20 md:pb-16 md:pt-28">
    <div class="mx-auto max-w-[760px] text-center">
      <h1 class="font-display text-[38px] leading-[1.1] sm:text-[46px] md:text-[54px]">
        I write about <em class="mark">this work</em>.
      </h1>
      <p class="mx-auto mt-7 max-w-[56ch] text-[18px] leading-[1.65] text-fern">
        Essays on growth, operations, and building a business that runs without you. Plus a shelf of evergreen guides.
      </p>
    </div>
  </section>

  <section class="px-6 py-12 md:py-16">
    <div class="mx-auto max-w-[800px]">
      <p class="text-[15px] font-semibold text-muted">Essays</p>
      {essays.length === 0 && (
        <p class="py-6 text-fern">No essays yet. Check back soon.</p>
      )}
      {essays.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block border-b border-hairline py-7 no-underline"
        >
          <time class="text-[14px] font-semibold text-muted">
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <h2 class="font-display mt-2 text-[24px] leading-snug text-ink transition-colors group-hover:text-moss">
            {post.data.title}
          </h2>
          <p class="mt-2 max-w-[64ch] leading-relaxed text-fern">{post.data.description}</p>
          <span class="mt-3 inline-block text-[14.5px] font-semibold text-moss">
            Read &rarr;
          </span>
        </a>
      ))}

      <p class="mt-16 text-[15px] font-semibold text-muted">Guides</p>
      <p class="mt-4 text-[15px] leading-relaxed text-fern">
        Evergreen how-tos and explainers. Useful, searchable, less personal than the essays above.
      </p>
      <div class="mt-2">
        {guides.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group flex items-baseline justify-between gap-6 border-b border-dashed border-hairline py-4 no-underline"
          >
            <span class="font-display text-[19px] leading-snug text-ink transition-colors group-hover:text-moss">
              {post.data.title}
            </span>
            <span class="flex-shrink-0 text-[14.5px] font-semibold text-moss">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NEXT STEP -->
  <section class="px-6 pb-20 md:pb-24">
    <div class="mx-auto max-w-[760px] rounded-[20px] border-2 border-moss/25 bg-white p-8 md:p-10">
      <h2 class="font-display text-[24px] leading-snug md:text-[27px]">Wondering which of these is your problem?</h2>
      <p class="mt-4 text-[17px] leading-[1.7] text-fern">
        The diagnostic runs your business through the same read I'd do on a call and hands you the one thing to fix first. Two minutes, free, and you don't have to talk to me to get it.
      </p>
      <a href="/diagnostic" class="mt-6 inline-block rounded-full bg-moss px-7 py-3.5 text-[15px] font-semibold text-white transition-opacity hover:opacity-90">Take the diagnostic</a>
    </div>
  </section>

</Layout>
