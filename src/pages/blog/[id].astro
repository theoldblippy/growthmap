---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { id: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} | Growth Map`}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
>
  <article class="px-6 py-16 md:py-24">
    <div class="mx-auto max-w-[700px]">
      <a
        href="/blog"
        class="text-[15px] font-semibold text-moss underline decoration-2 underline-offset-4 transition-colors hover:text-forest"
      >
        &larr; {post.data.guide ? 'Guides' : 'Field Notes'}
      </a>

      <time class="mt-8 block text-[14px] font-semibold text-muted">
        {post.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>

      <h1 class="font-display mt-4 text-3xl leading-[1.15] text-ink sm:text-4xl md:text-[44px]">
        {post.data.title}
      </h1>

      <div class="prose mt-10 max-w-none text-lg leading-relaxed text-ink
        prose-headings:font-serif prose-headings:font-bold prose-headings:text-forest
        prose-h2:mt-10 prose-h2:text-[28px]
        prose-p:my-5
        prose-a:text-moss prose-a:no-underline hover:prose-a:underline
        prose-strong:text-ink
        prose-li:my-1
        prose-ol:my-5 prose-ul:my-5
        prose-em:text-fern
        prose-blockquote:border-l-moss prose-blockquote:font-serif prose-blockquote:not-italic
      ">
        <Content />
      </div>

      <div class="mt-14 rounded-[20px] border-2 border-moss/25 bg-white p-8">
        <h2 class="font-display text-[22px] leading-snug md:text-[24px]">Not sure if this is your problem?</h2>
        <p class="mt-3.5 text-[16.5px] leading-[1.7] text-fern">
          The diagnostic asks six honest questions and tells you the one thing to fix first. Two minutes, free, no email or call required.
        </p>
        <a href="/diagnostic" class="mt-5 inline-block rounded-full bg-moss px-7 py-3.5 text-[15px] font-semibold text-white transition-opacity hover:opacity-90">Take the diagnostic</a>
      </div>

    </div>
  </article>
</Layout>
