---
const year = new Date().getFullYear();
const bookUrl = 'https://calendar.notion.so/meet/cameronearloliver/qc3y04oud';
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/results', label: 'Results' },
  { href: '/investors', label: 'For Private Equity' },
  { href: '/venture', label: 'For Venture' },
  { href: '/blog', label: 'Field Notes' },
  { href: '/diagnostic', label: 'Diagnostic' },
  { href: '/contact', label: 'Contact' },
];
---

<!-- Sitewide closer -->
<section class="bg-forest px-6 py-20 text-center md:py-24">
  <div class="mx-auto max-w-[700px]">
    <h2 class="font-display text-[32px] leading-[1.15] text-white md:text-[40px]">
      Find where <em class="text-sprout">you're</em> stuck.
    </h2>
    <p class="mx-auto mt-6 max-w-[52ch] text-[18px] leading-relaxed text-white/75">
      A free 30-minute call. We'll map where your business is and whether I can help. If I can't, I'll tell you.
    </p>
    <a
      href={bookUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-9 inline-block rounded-full bg-sprout px-9 py-4 text-[15px] font-semibold text-forest transition-opacity hover:opacity-90"
    >
      Book a call
    </a>
  </div>
</section>

<footer class="border-t border-white/15 bg-forest px-6 py-9 text-white/60">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-6 md:flex-row md:justify-between">
    <a href="/" class="font-display text-[19px] text-white no-underline">
      Growth Map<span class="text-sprout">.</span>
    </a>

    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-3">
      {links.map(({ href, label }) => (
        <a href={href} class="text-[14px] transition-colors hover:text-white">{label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="https://www.linkedin.com/in/cameronearloliver/"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-white"
        aria-label="Cameron Oliver on LinkedIn"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <p class="text-[14px]">&copy; {year} Growth Map</p>
    </div>
  </div>
</footer>
