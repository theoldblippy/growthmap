---
import Layout from '../layouts/Layout.astro';

const record = [
  { before: '$12M', after: '$20M', label: 'Construction revenue, on a rebuilt sales process' },
  { before: '120', after: '45 days', label: 'Onboarding time, unlocking $250K in new revenue' },
  { before: '40%', after: '85%', label: 'Utilization on underused contracts' },
  { before: '50%', after: '65%', label: 'Provider utilization, on smarter scheduling' },
];

const stations = [
  "Do enough of the right people know you exist?",
  "Are you winning good-fit customers, or taking whatever comes in?",
  "Do you close a healthy share of the leads you chase?",
  "Do new customers get off to a smooth start?",
  "Does the work get done well when you step away?",
  "Do customers stick around and send you more?",
];
---

<Layout
  title="What's the one thing holding your business back? | Growth Map"
  description="A free operating diagnostic for owner-led businesses. Answer a few honest questions and get the one thing to fix first, read the way Cameron would on a call."
  canonicalPath="/diagnostic"
>
  <section class="px-6 pt-14 pb-4 md:pt-20">
    <div id="diagnostic" class="mx-auto max-w-[760px]">
      <h1>What's the one thing holding your business back?</h1>
      <p class="sub">Answer a few honest questions and I'll run your business through the same read I'd do on a call. You'll get the one thing to fix first, and why. Takes about two minutes.</p>

      <!-- FORM -->
      <div id="form">
        <div class="field">
          <label for="business">What does your business do?</label>
          <input id="business" type="text" maxlength="200" placeholder="e.g. commercial electrical contractor" />
        </div>
        <div class="row">
          <div class="field">
            <label for="revenue">Revenue</label>
            <select id="revenue">
              <option value="">Pick one</option>
              <option>Under $1M</option>
              <option>$1M–$3M</option>
              <option>$3M–$10M</option>
              <option>$10M–$20M</option>
              <option>$20M+</option>
            </select>
          </div>
          <div class="field">
            <label for="team">Team size</label>
            <select id="team">
              <option value="">Pick one</option>
              <option>1–10</option>
              <option>11–25</option>
              <option>26–50</option>
              <option>51–100</option>
              <option>100+</option>
            </select>
          </div>
        </div>

        <p class="qlabel">Rate each honestly</p>
        <div id="stations">
          {stations.map((q, i) => (
            <div class="q" data-idx={i}>
              <span class="qnum">0{i + 1}</span>
              <span class="qtext">{q}</span>
              <span class="opts">
                <button type="button" data-v="g">Solid</button>
                <button type="button" data-v="y">Shaky</button>
                <button type="button" data-v="r">Broken</button>
              </span>
            </div>
          ))}
        </div>

        <div class="field">
          <label for="frustration">What's the most frustrating part of running it right now?</label>
          <textarea id="frustration" rows="3" maxlength="600" placeholder="A sentence or two, in your own words."></textarea>
        </div>
        <div class="field">
          <label for="email">Where should I send your read?</label>
          <input id="email" type="email" placeholder="you@company.com" />
        </div>

        <div class="ctarow">
          <button id="run" disabled>Show me the one thing</button>
          <p id="progress">Answer the six above to run it</p>
        </div>
      </div>

      <!-- LOADING -->
      <div id="loading" hidden>
        <p class="rlabel">Reading your business</p>
        <p class="loadingline">Running it through the map. One second.</p>
      </div>

      <!-- RESULT -->
      <div id="result" hidden></div>
    </div>
  </section>

  <!-- WHO'S ASKING -->
  <section class="border-t border-hairline bg-parchment-deep px-6 py-14 md:py-16">
    <div class="mx-auto max-w-[900px]">
      <p class="doc-label text-ink">Who's asking</p>
      <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-fern">
        I'm Cameron Oliver. I get in the trenches with owner-led businesses and fix what's actually holding them back. A few of the numbers I've helped move:
      </p>
      <div class="mt-9 grid grid-cols-2 gap-x-8 gap-y-8 md:grid-cols-4">
        {record.map((r) => (
          <div>
            <p class="font-display text-xl leading-none text-ink md:text-[26px]">
              {r.before} <span class="text-moss">&rarr;</span> {r.after}
            </p>
            <p class="mt-2 max-w-[26ch] text-[12.5px] leading-snug text-fern">{r.label}</p>
          </div>
        ))}
      </div>
      <a href="/testimonials" class="mt-9 inline-block font-mono text-[11px] font-medium uppercase tracking-[0.16em] text-moss transition-colors hover:text-ink">See the results &rarr;</a>
    </div>
  </section>
</Layout>

<style is:global>
  #diagnostic h1 { font-family: 'Castoro', Georgia, serif; font-weight: 400; font-size: 31px; line-height: 1.12; color: #2B331F; margin: 0 0 14px; }
  @media (min-width: 768px) { #diagnostic h1 { font-size: 40px; } }
  #diagnostic .sub { color: #59614A; font-size: 17px; line-height: 1.55; max-width: 60ch; margin: 0 0 34px; }
  #diagnostic .field { margin: 0 0 18px; }
  #diagnostic .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { #diagnostic .row { grid-template-columns: 1fr; } }
  #diagnostic label { display: block; font-size: 14px; font-weight: 600; color: #2B331F; margin: 0 0 7px; }
  #diagnostic input, #diagnostic select, #diagnostic textarea {
    width: 100%; box-sizing: border-box; border: 1px solid rgba(43,51,31,0.2); border-radius: 10px;
    background: #FAF8F0; padding: 11px 13px; font-family: inherit; font-size: 15px; color: #2B331F; }
  #diagnostic textarea { resize: vertical; }
  #diagnostic input:focus, #diagnostic select:focus, #diagnostic textarea:focus { outline: none; border-color: #5C7A3B; }
  #diagnostic .qlabel { font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #5C7A3B; margin: 26px 0 6px; }
  #diagnostic .q { border-bottom: 1px dashed rgba(43,51,31,0.15); padding: 16px 0; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  #diagnostic .q:first-of-type { border-top: 1px dashed rgba(43,51,31,0.15); }
  #diagnostic .qnum { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #5C7A3B; letter-spacing: .1em; flex: 0 0 24px; }
  #diagnostic .qtext { flex: 1; min-width: 200px; font-size: 15.5px; line-height: 1.4; color: #2B331F; }
  #diagnostic .opts { display: flex; gap: 6px; }
  #diagnostic .opts button { border: 1px solid rgba(43,51,31,0.15); background: transparent; border-radius: 8px; padding: 7px 13px; font-family: inherit; font-size: 13px; font-weight: 600; color: #59614A; cursor: pointer; transition: all .15s; }
  #diagnostic .opts button:hover { border-color: #2B331F; color: #2B331F; }
  #diagnostic .opts button.sel[data-v="g"] { background: #5C7A3B; border-color: #5C7A3B; color: #fff; }
  #diagnostic .opts button.sel[data-v="y"] { background: #C08A2D; border-color: #C08A2D; color: #fff; }
  #diagnostic .opts button.sel[data-v="r"] { background: #B0402F; border-color: #B0402F; color: #fff; }
  #diagnostic .ctarow { margin-top: 26px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  #diagnostic #run { border: none; background: #2B331F; color: #F5F0E1; font-family: inherit; font-size: 15px; font-weight: 600; padding: 15px 34px; border-radius: 999px; cursor: pointer; transition: opacity .2s; }
  #diagnostic #run:disabled { opacity: .35; cursor: not-allowed; }
  #diagnostic #run:not(:disabled):hover { opacity: .9; }
  #diagnostic #progress { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .08em; color: #59614A; }
  #diagnostic #loading[hidden], #diagnostic #result[hidden] { display: none; }
  #diagnostic #loading { margin-top: 30px; }
  #diagnostic .loadingline { font-family: 'Castoro', Georgia, serif; font-size: 20px; color: #2B331F; margin: 6px 0 0; }
  #diagnostic .rlabel { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #59614A; margin: 0 0 12px; }
  #diagnostic #result { margin-top: 40px; border-top: 1px solid rgba(43,51,31,0.15); padding-top: 36px; }
  #diagnostic .bars { display: flex; gap: 5px; margin: 0 0 8px; }
  #diagnostic .bar { flex: 1; height: 8px; border-radius: 4px; }
  #diagnostic .bar.flag { outline: 2px solid #2B331F; outline-offset: 2px; }
  #diagnostic .barlabels { display: flex; gap: 5px; margin: 0 0 28px; }
  #diagnostic .barlabels span { flex: 1; font-family: 'IBM Plex Mono', monospace; font-size: 8px; letter-spacing: .03em; color: #59614A; text-align: center; text-transform: uppercase; }
  #diagnostic #result h2 { font-family: 'Castoro', Georgia, serif; font-weight: 400; font-size: 27px; line-height: 1.15; color: #2B331F; margin: 0 0 16px; }
  #diagnostic .read { color: #2B331F; font-size: 18px; line-height: 1.6; margin: 0 0 24px; }
  #diagnostic .fixhead { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #5C7A3B; margin: 0 0 4px; }
  #diagnostic .fix { border-top: 1px dashed rgba(43,51,31,0.15); padding: 16px 0; }
  #diagnostic .fix .move { font-family: 'Castoro', Georgia, serif; font-size: 18px; color: #2B331F; margin: 0 0 4px; }
  #diagnostic .fix .why { color: #59614A; font-size: 15px; line-height: 1.55; margin: 0; }
  #diagnostic .close { margin-top: 28px; }
  #diagnostic .close .book { display: inline-block; background: #2B331F; color: #F5F0E1; text-decoration: none; font-weight: 600; font-size: 15px; padding: 15px 32px; border-radius: 999px; transition: opacity .2s; }
  #diagnostic .close .book:hover { opacity: .9; }
  #diagnostic .close .bookline { color: #59614A; font-size: 14px; line-height: 1.5; margin: 14px 0 0; max-width: 54ch; }
  #diagnostic .howlink { display: inline-block; margin-top: 18px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #5C7A3B; text-decoration: none; }
  #diagnostic .howlink:hover { color: #2B331F; }
</style>

<script>
  const BOOK = "https://calendar.notion.so/meet/cameronearloliver/qc3y04oud";
  const SHORT = ["Get noticed","Qualify","Win the work","Get started","Do the work","Keep them"];
  const ans = new Array(6).fill(null);

  document.querySelectorAll('#stations .q').forEach((row) => {
    const i = parseInt((row as HTMLElement).dataset.idx || '0', 10);
    row.querySelectorAll('.opts button').forEach((b) => {
      b.addEventListener('click', () => {
        ans[i] = (b as HTMLElement).dataset.v;
        row.querySelectorAll('.opts button').forEach((x) => x.classList.remove('sel'));
        b.classList.add('sel');
        const done = ans.filter(Boolean).length;
        const run = document.getElementById('run') as HTMLButtonElement;
        run.disabled = done < 6;
        document.getElementById('progress')!.textContent = done < 6 ? `${done} of 6 rated` : 'Ready';
      });
    });
  });

  function val(id: string) { return (document.getElementById(id) as HTMLInputElement).value.trim(); }

  document.getElementById('run')!.addEventListener('click', async () => {
    document.getElementById('form')!.setAttribute('hidden', '');
    document.getElementById('loading')!.removeAttribute('hidden');
    const payload = {
      business: val('business'), revenue: val('revenue'), team: val('team'),
      frustration: val('frustration'), email: val('email'), ratings: ans,
    };
    let data: any;
    try {
      const res = await fetch('/api/diagnose', {
        method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
      });
      data = await res.json();
    } catch {
      data = null;
    }
    document.getElementById('loading')!.setAttribute('hidden', '');
    const result = document.getElementById('result')!;
    if (!data || !data.verdict) {
      result.innerHTML = `<h2>That one's on me.</h2><p class="read">The read didn't come through. Rather than guess, let's just talk it through live.</p><div class="close"><a class="book" href="${BOOK}" target="_blank" rel="noopener noreferrer">Book a call</a></div>`;
      result.removeAttribute('hidden');
      return;
    }
    const idx = data.constraintIndex;
    const bars = ans.map((a, i) => {
      const col = a === 'g' ? '#5C7A3B' : a === 'y' ? '#C08A2D' : '#B0402F';
      const flag = (i === idx && idx >= 0) ? ' flag' : '';
      return `<div class="bar${flag}" style="background:${col}"></div>`;
    }).join('');
    const labels = SHORT.map((s) => `<span>${s}</span>`).join('');
    const fixes = (data.fixes || []).map((f: any) =>
      `<div class="fix"><p class="move">${f.move}</p><p class="why">${f.why}</p></div>`).join('');
    result.innerHTML =
      `<p class="rlabel">Your operating diagnostic</p>
       <div class="bars">${bars}</div>
       <div class="barlabels">${labels}</div>
       <h2>${data.verdict}</h2>
       <p class="read">${data.read}</p>
       <p class="fixhead">What I'd fix, in order</p>
       ${fixes}
       <div class="close">
         <a class="book" href="${BOOK}" target="_blank" rel="noopener noreferrer">Book a call</a>
         <p class="bookline">That's the read from a few answers. The real one is your actual numbers and 30 minutes with me. Free, no pitch. I'll tell you what I'd fix, and you can run with it.</p>
         <a class="howlink" href="/about">See how I work &rarr;</a>
       </div>`;
    result.removeAttribute('hidden');
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'diagnostic_complete', { constraint: data.constraintLabel || 'all_solid' });
    }
  });
</script>
