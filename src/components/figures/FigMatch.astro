<svg viewBox="0 0 440 240" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Three clients and three providers; dashed candidate lines converge, a human approves, and one solid match completes">
  <defs>
    <marker id="gm9-moss" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#26773F" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>


  <!-- column headers -->
  <text x="70" y="64" text-anchor="middle" font-family="'Jost', sans-serif" font-size="8" letter-spacing="0.12em" fill="#6E6E6E">CLIENTS</text>
  <text x="370" y="64" text-anchor="middle" font-family="'Jost', sans-serif" font-size="8" letter-spacing="0.12em" fill="#6E6E6E">PROVIDERS</text>

  <!-- candidate lines, dashed, into the review -->
  <line x1="77" y1="95" x2="207" y2="133" stroke="rgba(20,38,26,0.35)" stroke-width="1.1" stroke-dasharray="3 4"/>
  <line x1="77" y1="185" x2="207" y2="147" stroke="rgba(20,38,26,0.35)" stroke-width="1.1" stroke-dasharray="3 4"/>
  <line x1="233" y1="133" x2="362" y2="95" stroke="rgba(20,38,26,0.35)" stroke-width="1.1" stroke-dasharray="3 4"/>
  <line x1="233" y1="147" x2="362" y2="185" stroke="rgba(20,38,26,0.35)" stroke-width="1.1" stroke-dasharray="3 4"/>

  <!-- the one that completes -->
  <line x1="78" y1="140" x2="204" y2="140" stroke="#26773F" stroke-width="2.1"/>
  <line x1="236" y1="140" x2="359" y2="140" stroke="#26773F" stroke-width="2.1" marker-end="url(#gm9-moss)"/>
  <text x="300" y="130" text-anchor="middle" font-family="'Jost', sans-serif" font-size="8" letter-spacing="0.12em" fill="#26773F">MATCHED</text>

  <!-- human in the loop -->
  <circle cx="220" cy="140" r="14" fill="#FFFFFF" stroke="#26773F" stroke-width="1.5"/>
  <path d="M213 140 l5 5.5 l9 -11" fill="none" stroke="#26773F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="220" y="170" text-anchor="middle" font-family="'Jost', sans-serif" font-size="8" letter-spacing="0.14em" fill="#26773F">HUMAN OK</text>

  <!-- clients -->
  <circle cx="70" cy="92" r="5" fill="#FFFFFF" stroke="#14261A" stroke-width="1.9"/>
  <circle cx="70" cy="140" r="5" fill="#26773F"/>
  <circle cx="70" cy="188" r="5" fill="#FFFFFF" stroke="#14261A" stroke-width="1.9"/>

  <!-- providers -->
  <circle cx="370" cy="92" r="5" fill="#FFFFFF" stroke="#14261A" stroke-width="1.9"/>
  <circle cx="370" cy="140" r="5" fill="#26773F"/>
  <circle cx="370" cy="188" r="5" fill="#FFFFFF" stroke="#14261A" stroke-width="1.9"/>
</svg>