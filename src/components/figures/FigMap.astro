<svg viewBox="0 0 440 300" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Value map: people find you, they buy, you deliver, they come back">
  <defs>
    <marker id="gm1-ink" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#2B331F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
    <marker id="gm1-moss" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#5C7A3B" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <!-- corner label + dashed rule -->
  <text x="36" y="34" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="9.5" letter-spacing="0.14em" fill="#59614A">FIG. 01 &#183; THE MAP</text>
  <line x1="172" y1="30.5" x2="404" y2="30.5" stroke="rgba(43,51,31,0.15)" stroke-width="1" stroke-dasharray="3 4"/>

  <!-- step numbers -->
  <text x="52" y="64" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8.5" letter-spacing="0.14em" fill="#59614A">01</text>
  <text x="256" y="64" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8.5" letter-spacing="0.14em" fill="#59614A">02</text>
  <text x="256" y="172" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8.5" letter-spacing="0.14em" fill="#59614A">03</text>
  <text x="52" y="172" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8.5" letter-spacing="0.14em" fill="#59614A">04</text>

  <!-- connectors -->
  <line x1="190" y1="95" x2="249" y2="95" stroke="#2B331F" stroke-width="1.25" marker-end="url(#gm1-ink)"/>
  <line x1="322" y1="124" x2="322" y2="172" stroke="#2B331F" stroke-width="1.25" marker-end="url(#gm1-ink)"/>
  <line x1="250" y1="203" x2="191" y2="203" stroke="#2B331F" stroke-width="1.25" marker-end="url(#gm1-ink)"/>
  <!-- loop back: they come back -> people find you -->
  <path d="M 46 203 C 16 203 16 95 43 95" fill="none" stroke="#5C7A3B" stroke-width="1.25" stroke-dasharray="5 4" marker-end="url(#gm1-moss)"/>

  <!-- nodes -->
  <rect x="52" y="72" width="132" height="46" rx="8" fill="#FAF8F0" stroke="#5C7A3B" stroke-width="1.4"/>
  <text x="118" y="99.5" text-anchor="middle" font-family="'Manrope', 'Helvetica Neue', Arial, sans-serif" font-size="13" font-weight="500" fill="#2B331F">People find you</text>

  <rect x="256" y="72" width="132" height="46" rx="8" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/>
  <text x="322" y="99.5" text-anchor="middle" font-family="'Manrope', 'Helvetica Neue', Arial, sans-serif" font-size="13" font-weight="500" fill="#2B331F">They buy</text>

  <rect x="256" y="180" width="132" height="46" rx="8" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/>
  <text x="322" y="207.5" text-anchor="middle" font-family="'Manrope', 'Helvetica Neue', Arial, sans-serif" font-size="13" font-weight="500" fill="#2B331F">You deliver</text>

  <rect x="52" y="180" width="132" height="46" rx="8" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/>
  <text x="118" y="207.5" text-anchor="middle" font-family="'Manrope', 'Helvetica Neue', Arial, sans-serif" font-size="13" font-weight="500" fill="#2B331F">They come back</text>

  <!-- caption on the loop -->
  <text x="24" y="152" text-anchor="middle" transform="rotate(-90 24 152)" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8" letter-spacing="0.14em" fill="#5C7A3B">AND AGAIN</text>
</svg>