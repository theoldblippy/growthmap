<svg viewBox="0 0 440 240" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Three clients and three providers; dashed candidate lines converge, a human approves, and one solid match completes">
  <defs>
    <marker id="gm9-moss" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#5C7A3B" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <!-- corner label + dashed rule -->
  <text x="36" y="34" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="9.5" letter-spacing="0.14em" fill="#59614A">FIG. 09 &#183; THE MATCH</text>
  <line x1="190" y1="30.5" x2="404" y2="30.5" stroke="rgba(43,51,31,0.15)" stroke-width="1" stroke-dasharray="3 4"/>

  <!-- column headers -->
  <text x="70" y="64" text-anchor="middle" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8" letter-spacing="0.12em" fill="#59614A">CLIENTS</text>
  <text x="370" y="64" text-anchor="middle" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8" letter-spacing="0.12em" fill="#59614A">PROVIDERS</text>

  <!-- candidate lines, dashed, into the review -->
  <line x1="77" y1="95" x2="207" y2="133" stroke="rgba(43,51,31,0.35)" stroke-width="1.1" stroke-dasharray="3 4"/>
  <line x1="77" y1="185" x2="207" y2="147" stroke="rgba(43,51,31,0.35)" stroke-width="1.1" stroke-dasharray="3 4"/>
  <line x1="233" y1="133" x2="362" y2="95" stroke="rgba(43,51,31,0.35)" stroke-width="1.1" stroke-dasharray="3 4"/>
  <line x1="233" y1="147" x2="362" y2="185" stroke="rgba(43,51,31,0.35)" stroke-width="1.1" stroke-dasharray="3 4"/>

  <!-- the one that completes -->
  <line x1="78" y1="140" x2="204" y2="140" stroke="#5C7A3B" stroke-width="1.4"/>
  <line x1="236" y1="140" x2="359" y2="140" stroke="#5C7A3B" stroke-width="1.4" marker-end="url(#gm9-moss)"/>
  <text x="300" y="130" text-anchor="middle" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8" letter-spacing="0.12em" fill="#5C7A3B">MATCHED</text>

  <!-- human in the loop -->
  <circle cx="220" cy="140" r="14" fill="#FAF8F0" stroke="#5C7A3B" stroke-width="1.5"/>
  <path d="M213 140 l5 5.5 l9 -11" fill="none" stroke="#5C7A3B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="220" y="170" text-anchor="middle" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8" letter-spacing="0.14em" fill="#5C7A3B">HUMAN OK</text>

  <!-- clients -->
  <circle cx="70" cy="92" r="5" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/>
  <circle cx="70" cy="140" r="5" fill="#5C7A3B"/>
  <circle cx="70" cy="188" r="5" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/>

  <!-- providers -->
  <circle cx="370" cy="92" r="5" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/>
  <circle cx="370" cy="140" r="5" fill="#5C7A3B"/>
  <circle cx="370" cy="188" r="5" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/>
</svg>