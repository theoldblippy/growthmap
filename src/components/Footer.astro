---
const year = new Date().getFullYear();
---

<!-- Sitewide closer: dark olive, document grammar -->
<section class="bg-ink px-6 py-20 text-center md:py-24">
  <div class="mx-auto max-w-[700px]">
    <p class="doc-label inline-block !border-cream/20 px-4 text-cream/70">
      <b class="!text-[#AFC581]">→</b>NEXT STEP
    </p>
    <h2 class="font-display mt-6 text-3xl leading-tight text-cream md:text-[40px]">
      Find where <em class="!text-[#AFC581]">you're</em> stuck.
    </h2>
    <p class="mx-auto mt-5 max-w-[52ch] text-lg leading-relaxed text-cream/75">
      A free 30-minute call. We'll map where your business is and whether I can help. If I can't, I'll tell you.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a
        href="https://calendar.notion.so/meet/cameronearloliver/qc3y04oud"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full bg-cream px-8 py-3.5 text-base font-semibold text-ink transition-opacity hover:opacity-90"
      >
        Book a Free Consult
      </a>
      <a
        href="/time-audit"
        class="inline-block rounded-full border border-cream/30 px-8 py-3.5 text-base font-semibold text-cream transition-colors hover:border-cream"
      >
        Take the Time Audit
      </a>
    </div>
    <p class="mt-4 text-sm text-cream/50">3 minutes. No email required.</p>
  </div>
</section>

<footer class="border-t border-cream/15 bg-ink px-6 py-8 text-cream/60">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-5 md:flex-row md:justify-between">
    <a href="/" class="flex items-center gap-2 font-display text-lg text-cream/80 no-underline">
      <svg class="h-[18px] w-[18px] text-[#AFC581]" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="4" cy="20" r="2.2" fill="currentColor" />
        <path d="M4,20 C11,17 8,9 15,6.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-dasharray="0.5 3.2" stroke-linecap="round" />
        <path d="M17.5,1.5 c-2.7,0 -4.9,2.2 -4.9,4.9 c0,3.7 4.9,8.3 4.9,8.3 s4.9,-4.6 4.9,-8.3 C22.4,3.7 20.2,1.5 17.5,1.5 z M17.5,8.3 a1.9,1.9 0 1,1 0,-3.8 a1.9,1.9 0 0,1 0,3.8 z" fill="currentColor" />
      </svg>
      <span>Growth <em class="italic text-[#AFC581]">Map</em></span>
    </a>

    <nav class="flex flex-wrap justify-center gap-6">
      <a href="/" class="text-sm transition-colors hover:text-cream">Home</a>
      <a href="/about" class="text-sm transition-colors hover:text-cream">About</a>
      <a href="/blog" class="text-sm transition-colors hover:text-cream">Blog</a>
      <a href="/time-audit" class="text-sm transition-colors hover:text-cream">Time Audit</a>
      <a href="/contact" class="text-sm transition-colors hover:text-cream">Contact</a>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="https://www.linkedin.com/in/cameronearloliver/"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-cream"
        aria-label="LinkedIn"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <p class="text-sm">
        &copy; {year} Growth Map. All rights reserved.
      </p>
    </div>
  </div>
</footer>
