---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Preview · Revenue factory options" description="internal" canonicalPath="/preview-factory">

  <!-- ============ OPTION A — THE LINE ============ -->
  <div class="bg-moss/10 px-6 py-3 text-center font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-moss">Option A — The revenue line (stations, spots, handoffs, gauges)</div>
  <section class="px-6 py-12">
    <div class="mx-auto max-w-[820px] rounded-[14px] border border-hairline bg-white/60 p-6 md:p-8">
      <svg viewBox="0 0 620 330" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The revenue factory: find them, win them, do the work, keep them, with a gauge over each station">
        <defs>
          <marker id="fa-ink" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#2B331F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker>
          <marker id="fa-moss" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#5C7A3B" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker>
          <g id="pa"><circle cx="0" cy="-9" r="3.4" fill="#5C7A3B"/><path d="M-6 0 C-6 -5.5 6 -5.5 6 0 Z" fill="#5C7A3B"/></g>
        </defs>

        <text x="36" y="30" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="9.5" letter-spacing="0.14em" fill="#59614A">FIG &#183; THE REVENUE FACTORY</text>
        <line x1="290" y1="26.5" x2="584" y2="26.5" stroke="rgba(43,51,31,0.15)" stroke-width="1" stroke-dasharray="3 4"/>

        <!-- engine banners -->
        <text x="160" y="60" text-anchor="middle" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8.5" letter-spacing="0.16em" fill="#5C7A3B">GET CUSTOMERS</text>
        <line x1="52" y1="70" x2="272" y2="70" stroke="rgba(92,122,59,0.4)" stroke-width="1" stroke-dasharray="3 4"/>
        <text x="456" y="60" text-anchor="middle" font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace" font-size="8.5" letter-spacing="0.16em" fill="#5C7A3B">SERVE CUSTOMERS</text>
        <line x1="344" y1="70" x2="568" y2="70" stroke="rgba(92,122,59,0.4)" stroke-width="1" stroke-dasharray="3 4"/>

        <!-- gauges -->
        <g stroke-linecap="round">
          <path d="M85 104 A15 15 0 0 1 115 104" fill="none" stroke="rgba(43,51,31,0.2)" stroke-width="1.1"/><line x1="100" y1="104" x2="107" y2="94" stroke="#5C7A3B" stroke-width="1.6"/><circle cx="100" cy="104" r="2" fill="#5C7A3B"/>
          <path d="M205 104 A15 15 0 0 1 235 104" fill="none" stroke="rgba(43,51,31,0.2)" stroke-width="1.1"/><line x1="220" y1="104" x2="226" y2="93.6" stroke="#5C7A3B" stroke-width="1.6"/><circle cx="220" cy="104" r="2" fill="#5C7A3B"/>
          <path d="M381 104 A15 15 0 0 1 411 104" fill="none" stroke="rgba(43,51,31,0.2)" stroke-width="1.1"/><line x1="396" y1="104" x2="387" y2="96" stroke="#B0402F" stroke-width="1.6"/><circle cx="396" cy="104" r="2" fill="#B0402F"/>
          <path d="M501 104 A15 15 0 0 1 531 104" fill="none" stroke="rgba(43,51,31,0.2)" stroke-width="1.1"/><line x1="516" y1="104" x2="516" y2="92" stroke="#C08A2D" stroke-width="1.6"/><circle cx="516" cy="104" r="2" fill="#C08A2D"/>
        </g>
        <!-- gauge to station connectors -->
        <line x1="100" y1="119" x2="100" y2="160" stroke="rgba(43,51,31,0.15)" stroke-width="1" stroke-dasharray="2 3"/>
        <line x1="220" y1="119" x2="220" y2="160" stroke="rgba(43,51,31,0.15)" stroke-width="1" stroke-dasharray="2 3"/>
        <line x1="396" y1="119" x2="396" y2="160" stroke="rgba(43,51,31,0.15)" stroke-width="1" stroke-dasharray="2 3"/>
        <line x1="516" y1="119" x2="516" y2="160" stroke="rgba(43,51,31,0.15)" stroke-width="1" stroke-dasharray="2 3"/>

        <!-- stations -->
        <rect x="48" y="160" width="104" height="54" rx="9" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/><use href="#pa" x="100" y="180"/><text x="100" y="205" text-anchor="middle" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Find them</text>
        <rect x="168" y="160" width="104" height="54" rx="9" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/><use href="#pa" x="220" y="180"/><text x="220" y="205" text-anchor="middle" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Win them</text>
        <rect x="344" y="160" width="104" height="54" rx="9" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/><use href="#pa" x="396" y="180"/><text x="396" y="205" text-anchor="middle" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Do the work</text>
        <rect x="464" y="160" width="104" height="54" rx="9" fill="#FAF8F0" stroke="#2B331F" stroke-width="1.25"/><use href="#pa" x="516" y="180"/><text x="516" y="205" text-anchor="middle" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Keep them</text>

        <!-- handoffs -->
        <line x1="154" y1="187" x2="166" y2="187" stroke="#2B331F" stroke-width="1.25" marker-end="url(#fa-ink)"/>
        <line x1="274" y1="187" x2="342" y2="187" stroke="#2B331F" stroke-width="1.25" marker-end="url(#fa-ink)"/>
        <line x1="450" y1="187" x2="462" y2="187" stroke="#2B331F" stroke-width="1.25" marker-end="url(#fa-ink)"/>

        <!-- belt -->
        <rect x="40" y="224" width="544" height="12" rx="6" fill="#ECE6D0" stroke="rgba(43,51,31,0.15)" stroke-width="1"/>
        <g fill="rgba(43,51,31,0.22)"><circle cx="64" cy="230" r="2.3"/><circle cx="112" cy="230" r="2.3"/><circle cx="160" cy="230" r="2.3"/><circle cx="208" cy="230" r="2.3"/><circle cx="256" cy="230" r="2.3"/><circle cx="304" cy="230" r="2.3"/><circle cx="352" cy="230" r="2.3"/><circle cx="400" cy="230" r="2.3"/><circle cx="448" cy="230" r="2.3"/><circle cx="496" cy="230" r="2.3"/><circle cx="544" cy="230" r="2.3"/></g>

        <!-- in / out labels -->
        <text x="40" y="252" font-family="'IBM Plex Mono',monospace" font-size="8" letter-spacing="0.12em" fill="#5C7A3B">A LEAD IN</text>
        <text x="584" y="252" text-anchor="end" font-family="'IBM Plex Mono',monospace" font-size="8" letter-spacing="0.12em" fill="#5C7A3B">REVENUE OUT</text>

        <!-- repeat loop -->
        <path d="M516 214 C516 288 100 288 100 216" fill="none" stroke="#5C7A3B" stroke-width="1.25" stroke-dasharray="5 4" marker-end="url(#fa-moss)"/>
        <rect x="248" y="278" width="120" height="12" fill="#FAF8F0"/>
        <text x="308" y="286" text-anchor="middle" font-family="'IBM Plex Mono',monospace" font-size="8" letter-spacing="0.14em" fill="#5C7A3B">AND THEY COME BACK</text>

        <!-- legend -->
        <rect x="40" y="308" width="9" height="9" rx="2" fill="#5C7A3B"/><text x="56" y="316" font-family="'IBM Plex Mono',monospace" font-size="8" letter-spacing="0.12em" fill="#59614A">ON TRACK</text>
        <rect x="150" y="308" width="9" height="9" rx="2" fill="#C08A2D"/><text x="166" y="316" font-family="'IBM Plex Mono',monospace" font-size="8" letter-spacing="0.12em" fill="#59614A">WATCH</text>
        <rect x="240" y="308" width="9" height="9" rx="2" fill="#B0402F"/><text x="256" y="316" font-family="'IBM Plex Mono',monospace" font-size="8" letter-spacing="0.12em" fill="#59614A">IN THE RED</text>
      </svg>
    </div>
  </section>

  <!-- ============ OPTION B — TWO ENGINES ============ -->
  <div class="bg-moss/10 px-6 py-3 text-center font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-moss">Option B — Two engines (the two things, as machinery)</div>
  <section class="px-6 py-12">
    <div class="mx-auto max-w-[820px] rounded-[14px] border border-hairline bg-white/60 p-6 md:p-8">
      <svg viewBox="0 0 620 300" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Two engines: a growth engine that gets customers feeds a fulfillment engine that serves them">
        <defs>
          <marker id="fb-ink" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#2B331F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker>
          <marker id="fb-moss" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#5C7A3B" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker>
          <g id="pb"><circle cx="0" cy="-7" r="2.8" fill="#5C7A3B"/><path d="M-5 0 C-5 -4.5 5 -4.5 5 0 Z" fill="#5C7A3B"/></g>
        </defs>

        <text x="36" y="30" font-family="'IBM Plex Mono',monospace" font-size="9.5" letter-spacing="0.14em" fill="#59614A">FIG &#183; THE REVENUE FACTORY</text>
        <line x1="290" y1="26.5" x2="584" y2="26.5" stroke="rgba(43,51,31,0.15)" stroke-width="1" stroke-dasharray="3 4"/>

        <!-- MODULE 1 -->
        <rect x="44" y="66" width="238" height="150" rx="14" fill="#FAF8F0" stroke="#5C7A3B" stroke-width="1.5"/>
        <text x="68" y="94" font-family="'IBM Plex Mono',monospace" font-size="9" letter-spacing="0.14em" fill="#5C7A3B">THE GROWTH ENGINE</text>
        <text x="68" y="108" font-family="'Manrope',sans-serif" font-size="10.5" fill="#59614A">Get customers</text>
        <!-- chip 1 -->
        <rect x="64" y="120" width="198" height="38" rx="8" fill="#FFFFFF" fill-opacity="0.6" stroke="#2B331F" stroke-width="1.1"/><use href="#pb" x="88" y="143"/><text x="104" y="143" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Find them</text><circle cx="244" cy="139" r="4.5" fill="#5C7A3B"/>
        <!-- chip 2 -->
        <rect x="64" y="166" width="198" height="38" rx="8" fill="#FFFFFF" fill-opacity="0.6" stroke="#2B331F" stroke-width="1.1"/><use href="#pb" x="88" y="189"/><text x="104" y="189" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Win them</text><circle cx="244" cy="185" r="4.5" fill="#C08A2D"/>

        <!-- handoff -->
        <line x1="286" y1="141" x2="334" y2="141" stroke="#2B331F" stroke-width="1.5" marker-end="url(#fb-ink)"/>
        <text x="310" y="132" text-anchor="middle" font-family="'IBM Plex Mono',monospace" font-size="7.5" letter-spacing="0.1em" fill="#59614A">HANDOFF</text>

        <!-- MODULE 2 -->
        <rect x="338" y="66" width="238" height="150" rx="14" fill="#FAF8F0" stroke="#5C7A3B" stroke-width="1.5"/>
        <text x="362" y="94" font-family="'IBM Plex Mono',monospace" font-size="9" letter-spacing="0.14em" fill="#5C7A3B">THE FULFILLMENT ENGINE</text>
        <text x="362" y="108" font-family="'Manrope',sans-serif" font-size="10.5" fill="#59614A">Serve customers</text>
        <rect x="358" y="120" width="198" height="38" rx="8" fill="#FFFFFF" fill-opacity="0.6" stroke="#2B331F" stroke-width="1.1"/><use href="#pb" x="382" y="143"/><text x="398" y="143" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Do the work</text><circle cx="538" cy="139" r="4.5" fill="#B0402F"/>
        <rect x="358" y="166" width="198" height="38" rx="8" fill="#FFFFFF" fill-opacity="0.6" stroke="#2B331F" stroke-width="1.1"/><use href="#pb" x="382" y="189"/><text x="398" y="189" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Keep them</text><circle cx="538" cy="185" r="4.5" fill="#5C7A3B"/>

        <!-- revenue output -->
        <line x1="457" y1="216" x2="457" y2="240" stroke="#5C7A3B" stroke-width="1.25" marker-end="url(#fb-moss)"/>
        <rect x="397" y="244" width="120" height="32" rx="16" fill="#EDF0E3" stroke="#5C7A3B" stroke-width="1.3"/>
        <text x="457" y="264" text-anchor="middle" font-family="'Manrope',sans-serif" font-size="12" font-weight="600" fill="#2B331F">Revenue</text>

        <!-- repeat loop back to module 1 -->
        <path d="M397 260 C160 260 163 232 163 232" fill="none" stroke="#5C7A3B" stroke-width="1.25" stroke-dasharray="5 4"/>
        <path d="M163 240 L163 218" fill="none" stroke="#5C7A3B" stroke-width="1.25" marker-end="url(#fb-moss)"/>
        <rect x="238" y="254" width="118" height="12" fill="#F5F0E1"/>
        <text x="297" y="262" text-anchor="middle" font-family="'IBM Plex Mono',monospace" font-size="8" letter-spacing="0.12em" fill="#5C7A3B">THEY COME BACK</text>

        <!-- legend -->
        <rect x="44" y="284" width="8" height="8" rx="2" fill="#5C7A3B"/><text x="58" y="291" font-family="'IBM Plex Mono',monospace" font-size="7.5" letter-spacing="0.1em" fill="#59614A">ON TRACK</text>
        <rect x="150" y="284" width="8" height="8" rx="2" fill="#C08A2D"/><text x="164" y="291" font-family="'IBM Plex Mono',monospace" font-size="7.5" letter-spacing="0.1em" fill="#59614A">WATCH</text>
        <rect x="240" y="284" width="8" height="8" rx="2" fill="#B0402F"/><text x="254" y="291" font-family="'IBM Plex Mono',monospace" font-size="7.5" letter-spacing="0.1em" fill="#59614A">IN THE RED</text>
      </svg>
    </div>
  </section>

</Layout>
