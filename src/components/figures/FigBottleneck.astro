<svg viewBox="0 0 440 300" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The same value map with one step flagged in red: the bottleneck is delivery">
  <defs>
    <marker id="gm3-calm" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="rgba(20,38,26,0.55)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
    <marker id="gm3-rust" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M2 1.5 L7.5 5 L2 8.5" fill="none" stroke="#B0402F" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>


  <!-- calm connectors -->
  <line x1="170" y1="116" x2="225" y2="116" stroke="rgba(20,38,26,0.55)" stroke-width="1.1" marker-end="url(#gm3-calm)"/>
  <line x1="226" y1="216" x2="171" y2="216" stroke="rgba(20,38,26,0.55)" stroke-width="1.1" marker-end="url(#gm3-calm)"/>
  <path d="M 38 216 C 12 216 12 116 36 116" fill="none" stroke="rgba(20,38,26,0.4)" stroke-width="1.1" stroke-dasharray="4 4" marker-end="url(#gm3-calm)"/>

  <!-- the pinched link into delivery (rust) -->
  <line x1="292" y1="142" x2="292" y2="188" stroke="#B0402F" stroke-width="2.1" marker-end="url(#gm3-rust)"/>
  <path d="M 282 149 L 288 163 L 282 177" fill="none" stroke="#B0402F" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M 302 149 L 296 163 L 302 177" fill="none" stroke="#B0402F" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- calm nodes -->
  <rect x="44" y="96" width="120" height="40" rx="7" fill="#FFFFFF" stroke="rgba(20,38,26,0.5)" stroke-width="1.1"/>
  <text x="104" y="120" text-anchor="middle" font-family="'Jost', sans-serif" font-size="11.5" font-weight="500" fill="#6E6E6E">People find you</text>

  <rect x="232" y="96" width="120" height="40" rx="7" fill="#FFFFFF" stroke="rgba(20,38,26,0.5)" stroke-width="1.1"/>
  <text x="292" y="120" text-anchor="middle" font-family="'Jost', sans-serif" font-size="11.5" font-weight="500" fill="#6E6E6E">They buy</text>

  <rect x="44" y="196" width="120" height="40" rx="7" fill="#FFFFFF" stroke="rgba(20,38,26,0.5)" stroke-width="1.1"/>
  <text x="104" y="220" text-anchor="middle" font-family="'Jost', sans-serif" font-size="11.5" font-weight="500" fill="#6E6E6E">They come back</text>

  <!-- the bottleneck node (rust) -->
  <rect x="232" y="196" width="120" height="40" rx="7" fill="rgba(176,64,47,0.06)" stroke="#B0402F" stroke-width="1.6"/>
  <text x="292" y="220" text-anchor="middle" font-family="'Jost', sans-serif" font-size="11.5" font-weight="600" fill="#14261A">You deliver</text>

  <!-- stamp tag + dashed leader -->
  <g transform="translate(280 42) rotate(-7)">
    <rect x="0" y="0" width="132" height="26" rx="4" fill="rgba(176,64,47,0.05)" stroke="#B0402F" stroke-width="2.1"/>
    <text x="66" y="17" text-anchor="middle" font-family="'Jost', sans-serif" font-size="9" letter-spacing="0.12em" fill="#B0402F">THE BOTTLENECK</text>
  </g>
  <path d="M 356 76 C 378 118 372 156 342 190" fill="none" stroke="#B0402F" stroke-width="1.1" stroke-dasharray="3 4" marker-end="url(#gm3-rust)"/>
</svg>